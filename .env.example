# ============================================================
# MEMORY//OS — environment template
# Copy to backend/.env only if you want to change defaults.
# EVERY VALUE BELOW IS OPTIONAL. The demo runs with no .env
# file at all, no API keys, and no paid services.
# ============================================================

# ---- Model provider -----------------------------------------------------
# demo   : deterministic local responses, no LLM, no network. (default)
# ollama : real model-driven tool calling via a local Ollama server (free).
#          Requires: `pip install langchain-ollama` + a running Ollama.
# openai : real model-driven tool calling via OpenAI (PAID, your own key).
#          Requires: `pip install langchain-openai` + OPENAI_API_KEY.
MODEL_PROVIDER=demo

# Used only when MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Used only when MODEL_PROVIDER=openai. Never commit a real key.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Storage ------------------------------------------------------------
# Where ChromaDB, SQLite and LangGraph checkpoints are written.
MEMORY_OS_DATA_DIR=./.data

# ---- Voice --------------------------------------------------------------
# Leave unset to use the browser's SpeechRecognition API (default).
# Set to a faster-whisper size (tiny/base/small) for local server-side
# transcription. Requires: `pip install faster-whisper`.
# WHISPER_MODEL=base

# ---- Frontend -----------------------------------------------------------
# Where the Next.js dev/prod server proxies /api/* requests.
BACKEND_URL=http://127.0.0.1:8000
