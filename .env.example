# ============================================================
# MEMORY//OS — environment template
# Copy to backend/.env only if you want to change defaults.
# EVERY VALUE BELOW IS OPTIONAL. The demo runs with no .env
# file at all, no API keys, and no paid services.
# ============================================================

# ---- Model provider -----------------------------------------------------
# demo   : deterministic local responses, no LLM, no network. (default)
# ollama : real model-driven tool calling via a local Ollama server (free).
#          Requires: `pip install langchain-ollama` + a running Ollama.
# openai : real model-driven tool calling via OpenAI (PAID, your own key).
#          Requires: `pip install langchain-openai` + OPENAI_API_KEY.
MODEL_PROVIDER=demo

# Used only when MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Used only when MODEL_PROVIDER=openai. Never commit a real key.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Storage ------------------------------------------------------------
# Where ChromaDB, SQLite and LangGraph checkpoints are written.
MEMORY_OS_DATA_DIR=./.data

# ---- Voice --------------------------------------------------------------
# Leave unset to use the browser's SpeechRecognition API (default).
# Set to a faster-whisper size (tiny/base/small) for local server-side
# transcription. Requires: `pip install faster-whisper`.
# WHISPER_MODEL=base

# ---- Frontend -----------------------------------------------------------
# Where the Next.js dev/prod server proxies /api/* requests.
BACKEND_URL=http://127.0.0.1:8000

# ==========================================================================
# V8.5 PRODUCTION TRUST (all optional; defaults preserve local demo mode)
# ==========================================================================

# ---- Authentication ------------------------------------------------------
# disabled : local single-user demo, identical to V8.4.4. (default)
# required : real multi-user mode. Every API call outside the public
#            allowlist needs an authenticated session.
AUTH_MODE=disabled

# Assert a production deployment. Startup FAILS unless AUTH_MODE=required,
# CORS_ORIGINS is explicit, and COOKIE_SECURE is enabled.
PRODUCTION=0

# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# Send the session cookie only over HTTPS. Defaults to the PRODUCTION value.
COOKIE_SECURE=0

# PBKDF2-HMAC-SHA256 iterations for password hashing (default 600000).
AUTH_PBKDF2_ITERATIONS=600000

# Allow open self-registration (first account owns the default workspace).
AUTH_ALLOW_REGISTRATION=1

# Optional bootstrap owner created at startup FROM THE ENVIRONMENT ONLY.
# Never put real credentials in a committed file.
# AUTH_BOOTSTRAP_EMAIL=
# AUTH_BOOTSTRAP_PASSWORD=

# ---- CORS ----------------------------------------------------------------
# "*" is the local demo default. Production MUST list explicit origins.
# CORS_ORIGINS=https://app.example.com

# ---- Rate limiting -------------------------------------------------------
# Defaults ON when AUTH_MODE=required, OFF in the local demo.
# RATE_LIMIT_ENABLED=1
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_RESEARCH_PER_MINUTE=30
RATE_LIMIT_PORTABILITY_PER_MINUTE=10
RATE_LIMIT_EXPENSIVE_PER_MINUTE=30

# ---- Request bounds ------------------------------------------------------
# Global request body cap in bytes (portability keeps its own tighter caps).
MAX_REQUEST_BYTES=67108864

# ---- Observability -------------------------------------------------------
# Emit single-line JSON logs (redacted) for production log pipelines.
LOG_JSON=0
